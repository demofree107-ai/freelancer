{
  "name": "school-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "node --watch server/index.js",
    "dev:web": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "concurrently -k 'npm:start:api' 'npm:start:web'",
    "start:api": "node server/index.js",
    "start:web": "next start --hostname 0.0.0.0",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "next": "^16.1.6",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "postcss": "^8.5.6",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.18"
  }
}
